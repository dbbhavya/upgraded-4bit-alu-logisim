      <a name="halign" val="left"/>
      <a name="text" val="000  ADD  A + B     -&gt; Carry"/>
    </comp>
    <comp lib="6" loc="(40,560)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="001  SUB  A - B     -&gt; Borrow"/>
    </comp>
    <comp lib="6" loc="(40,580)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="halign" val="left"/>
      <a name="text" val="010  AND  A AND B"/>
    </comp>
