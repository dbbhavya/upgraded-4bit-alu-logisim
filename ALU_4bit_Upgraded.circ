    <comp lib="6" loc="(200,115)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="operand A (click bits)"/>
    </comp>
    <comp lib="6" loc="(200,165)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="operand B (click bits)"/>
    </comp>
    <comp lib="6" loc="(200,415)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="CLK : click = one clock pulse"/>
    </comp>
    <comp lib="6" loc="(200,465)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="CLR : click = clear registers"/>
    </comp>
    <comp lib="6" loc="(2070,240)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="0 = hold Q"/>
    </comp>
    <comp lib="6" loc="(2070,250)" name="Text">
      <a name="font" val="SansSerif plain 10"/>
      <a name="halign" val="left"/>
      <a name="text" val="1 = load Y"/>
    </comp>
    <comp lib="6" loc="(2105,115)" name="Text">
      <a name="font" val="SansSerif bold 10"/>
      <a name="text" val="LOAD MUX"/>
    </comp>
    <comp lib="6" loc="(215,365)" name="Text">
      <a name="font" val="SansSerif plain 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="LOAD = 1 : store on next CLK"/>
    </comp>
    <comp lib="6" loc="(2280,190)" name="Text">
      <a name="font" val="SansSerif bold 11"/>
      <a name="halign" val="left"/>
      <a name="text" val="bit 0"/>
